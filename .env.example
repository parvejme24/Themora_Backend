# Runtime
NODE_ENV=development
PORT=5050
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Frontend origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5174

# Authentication
BCRYPT_ROUNDS=12

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=Themora <your-email@example.com>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=

# Public URL of this API (SSLCommerz posts back to it)
BACKEND_URL=http://localhost:5050

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
# Webhook endpoint: <BACKEND_URL>/api/v1/webhooks/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired, charge.refunded,
#           invoice.paid, invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SSLCommerz (sandbox store from https://developer.sslcommerz.com/registration/)
# IPN URL: <BACKEND_URL>/api/v1/webhooks/sslcommerz
SSLCOMMERZ_STORE_ID=your-sandbox-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sandbox-store-password
SSLCOMMERZ_SANDBOX=true
USD_TO_BDT_RATE=122

# Refund requests are accepted for this many days after payment
REFUND_WINDOW_DAYS=14

# Google sign-in: OAuth client ID(s) whose ID tokens are accepted (comma-separated)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Vercel Cron (daily jobs). Any long random string; set the same value in Vercel
CRON_SECRET=generate-a-long-random-string

# Error tracking (optional): DSN from https://sentry.io
SENTRY_DSN=
LOG_LEVEL=info
